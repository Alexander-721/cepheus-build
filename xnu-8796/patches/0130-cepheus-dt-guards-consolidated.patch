diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index f2999fe..cb4b3ad 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -380,7 +380,8 @@ phystokv(pmap_paddr_t pa)
 		}
 	}
 	if (__improbable((pa < gPhysBase) || ((pa - gPhysBase) >= real_phys_size))) {
-		panic("%s: illegal PA: 0x%llx; phys base 0x%llx, size 0x%llx", __func__,
+		cepheus_early_mark(20, "H1: phystokv illegal PA -> 0");
+		return 0; phys base 0x%llx, size 0x%llx", __func__,
 		    (unsigned long long)pa, (unsigned long long)gPhysBase, (unsigned long long)real_phys_size);
 	}
 	return pa - gPhysBase + gVirtBase;
@@ -1292,6 +1293,12 @@ arm_vm_prot_init(__unused boot_args * args)
 
 		err = SecureDTGetProperty(memory_map, "TrustCache", (void const **)&trustCacheRange, &trustCacheRangeSize);
 		if (err == kSuccess) {
+			/* CEPHEUS: reject a TrustCache range that is not in RAM. */
+			if (trustCacheRange->paddr < gPhysBase ||
+			    (trustCacheRange->paddr - gPhysBase) >= real_phys_size) {
+				cepheus_early_mark(20, "C1: trustcache PA rejected");
+				goto noTrustCache;
+			}
 			if (trustCacheRangeSize != sizeof(DTMemoryMapRange)) {
 				panic("Unexpected /chosen/memory-map/TrustCache property size %u != %zu", trustCacheRangeSize, sizeof(DTMemoryMapRange));
 			}
@@ -1349,7 +1356,12 @@ arm_vm_prot_init(__unused boot_args * args)
 	}
 	assert(auxKC_header_range_size == sizeof(DTMemoryMapRange));
 
-	if (auxKC_header_range->paddr == 0 || auxKC_range->paddr == 0) {
+	if (auxKC_header_range->paddr == 0 || auxKC_range->paddr == 0 ||
+	    auxKC_header_range->paddr < gPhysBase ||
+	    (auxKC_header_range->paddr - gPhysBase) >= real_phys_size ||
+	    auxKC_range->paddr < gPhysBase ||
+	    (auxKC_range->paddr - gPhysBase) >= real_phys_size) {
+		cepheus_early_mark(20, "C2: auxkc PA rejected");
 		goto noAuxKC;
 	}
 
