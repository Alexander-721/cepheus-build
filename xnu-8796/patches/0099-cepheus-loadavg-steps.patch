@@ -8191,6 +8199,7 @@ sched_update_pset_load_average(processor_set_t pset, uint64_t curtime)
 		}
 	}
 	os_atomic_store(&pset->pset_load_last_update, curtime, relaxed);
+	cepheus_early_mark(20, "S6: load average stored");
 }
 
