diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index 8e29586..e0a3db3 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -1,3 +1,6 @@
+/* CEPHEUS bring-up: early console markers. */
+extern void cepheus_early_mark(unsigned int stage, const char *label);
+
 /*
