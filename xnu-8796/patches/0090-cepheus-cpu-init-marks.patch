diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 25fde23..2fca6e9 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -1,3 +1,6 @@
+/* CEPHEUS bring-up: early console markers (see arm_init.c). */
+extern void cepheus_early_mark(unsigned int stage, const char *label);
+
 /*
  * Copyright (c) 2007-2021 Apple Inc. All rights reserved.
  *
@@ -679,9 +682,12 @@ cpu_init(void)
 	cpu_data_t     *cdp = getCpuDatap();
 	arm_cpu_info_t *cpu_info_p;
 
+	cepheus_early_mark(20, "E: cpu_init enter");
 	assert(exception_stack_pointer() != 0);
+	cepheus_early_mark(20, "F: excep stack ok");
 
 	if (cdp->cpu_type != CPU_TYPE_ARM64) {
+		cepheus_early_mark(20, "G: first cpu init");
 		cdp->cpu_type = CPU_TYPE_ARM64;
 
 		timer_call_queue_init(&cdp->rtclock_timer.queue);
@@ -689,7 +695,9 @@ cpu_init(void)
 
 		if (cdp == &BootCpuData) {
 			do_cpuid();
+			cepheus_early_mark(20, "H: after do_cpuid");
 			do_mvfpid();
+			cepheus_early_mark(20, "I: after do_mvfpid");
 		} else {
 			/*
 			 * We initialize non-boot CPUs here; the boot CPU is
@@ -699,11 +707,14 @@ cpu_init(void)
 		}
 
 		do_cacheid();
+		cepheus_early_mark(20, "J: after do_cacheid");
 
 		/* ARM_SMP: Assuming identical cpu */
 		do_debugid();
+		cepheus_early_mark(20, "K: after do_debugid");
 
 		cpu_info_p = cpuid_info();
+		cepheus_early_mark(20, "L: after cpuid_info");
 
 		/* switch based on CPU's reported architecture */
 		switch (cpu_info_p->arm_info.arm_arch) {
@@ -720,6 +731,7 @@ cpu_init(void)
 			break;
 		}
 
+		cepheus_early_mark(20, "M: arch switch done");
 		cdp->cpu_threadtype = CPU_THREADTYPE_NONE;
 	}
 	cdp->cpu_stat.irq_ex_cnt_wake = 0;
@@ -731,10 +743,14 @@ cpu_init(void)
 	cdp->cpu_sleep_token_last = cdp->cpu_sleep_token;
 	cdp->cpu_sleep_token = 0x0UL;
 #if KPC
+	cepheus_early_mark(20, "N: before kpc_idle_exit");
 	kpc_idle_exit();
+	cepheus_early_mark(20, "O: after kpc_idle_exit");
 #endif /* KPC */
 #if MONOTONIC
+	cepheus_early_mark(20, "P: before mt_cpu_up");
 	mt_cpu_up(cdp);
+	cepheus_early_mark(20, "Q: after mt_cpu_up");
 #endif /* MONOTONIC */
 }
 
