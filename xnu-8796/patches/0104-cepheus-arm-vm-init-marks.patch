diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 8b28a1d..30c896d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1,3 +1,6 @@
+/* CEPHEUS bring-up: early console markers. */
+extern void cepheus_early_mark(unsigned int stage, const char *label);
+
 /*
  * Copyright (c) 2007-2011 Apple Inc. All rights reserved.
  *
@@ -1830,6 +1833,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 * Get the virtual and physical kernel-managed memory base from boot_args.
 	 */
 	gVirtBase = args->virtBase;
+	cepheus_early_mark(20, "V1: arm_vm_init entered");
 	gPhysBase = args->physBase;
 #if KASAN
 	real_phys_size = args->memSize + (shadow_ptop - shadow_pbase);
@@ -1846,6 +1850,8 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 * in units of the hardware page size and should not need similar treatment.
 	 */
 	gPhysSize = mem_size = ((gPhysBase + args->memSize) & ~PAGE_MASK) - gPhysBase;
+	cepheus_early_mark(20, mem_size > (1ULL << 38)
+	    ? "V2: mem_size huge" : "V2: mem_size sane");
 
 	mem_actual = args->memSizeActual ? args->memSizeActual : mem_size;
 
@@ -1855,6 +1861,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	} else {
 		max_mem_actual = mem_actual;
 	}
+	cepheus_early_mark(20, "V3: before size check");
 	if (mem_size >= ((VM_MAX_KERNEL_ADDRESS - VM_MIN_KERNEL_ADDRESS) / 2)) {
 		panic("Unsupported memory configuration %lx", mem_size);
 	}
