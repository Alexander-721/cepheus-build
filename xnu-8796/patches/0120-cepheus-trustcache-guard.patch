 		err = SecureDTGetProperty(memory_map, "TrustCache", (void const **)&trustCacheRange, &trustCacheRangeSize);
 		if (err == kSuccess) {
+			/*
+			 * CEPHEUS: the device tree we supply has a TrustCache range
+			 * outside RAM, and phystokv() panics on such an address. Skip
+			 * the trust cache entirely rather than fault early in boot.
+			 */
+			if (trustCacheRange->paddr < gPhysBase ||
