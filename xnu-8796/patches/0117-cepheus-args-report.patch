diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 15fffd9..9da4999 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1834,6 +1834,11 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	/*
 	 * Get the virtual and physical kernel-managed memory base from boot_args.
 	 */
+	uintptr_t ceph_dbg_virt = args->virtBase;
+	uintptr_t ceph_dbg_phys = args->physBase;
+	uint64_t ceph_dbg_size = args->memSize;
+	uintptr_t ceph_dbg_top = args->topOfKernelData;
+	cepheus_early_args_report(ceph_dbg_virt, ceph_dbg_phys, ceph_dbg_size, ceph_dbg_top);
 	gVirtBase = args->virtBase;
 	cepheus_early_mark(20, "V1: arm_vm_init entered");
 	gPhysBase = args->physBase;
diff --git a/osfmk/arm64/cepheus_early.c b/osfmk/arm64/cepheus_early.c
index c1c9d48..334f39f 100644
--- a/osfmk/arm64/cepheus_early.c
+++ b/osfmk/arm64/cepheus_early.c
@@ -417,3 +417,18 @@ cepheus_early_disable(void)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 #endif /* CEPHEUS */
+
+void
+cepheus_early_args_report(uintptr_t virt_base, uintptr_t phys_base,
+    uint64_t mem_size, uintptr_t top_of_kernel_data)
+{
+	cepheus_early_string("\nCEPH ARGS virt=0x");
+	cepheus_early_hex(virt_base);
+	cepheus_early_string("\nCEPH ARGS phys=0x");
+	cepheus_early_hex(phys_base);
+	cepheus_early_string("\nCEPH ARGS size=0x");
+	cepheus_early_hex((uintptr_t)mem_size);
+	cepheus_early_string("\nCEPH ARGS top=0x");
+	cepheus_early_hex(top_of_kernel_data);
+	cepheus_early_putc('\n');
+}
