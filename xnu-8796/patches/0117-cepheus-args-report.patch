+
+void
+cepheus_early_args_report(uintptr_t virt_base, uintptr_t phys_base,
+    uint64_t mem_size, uintptr_t top_of_kernel_data)
+{
+	cepheus_early_string("\nCEPH ARGS virt=0x");
+	cepheus_early_hex(virt_base);
+	cepheus_early_string("\nCEPH ARGS phys=0x");
+	cepheus_early_hex(phys_base);
+	cepheus_early_string("\nCEPH ARGS size=0x");
+	cepheus_early_hex((uintptr_t)mem_size);
+	cepheus_early_string("\nCEPH ARGS top=0x");
+	cepheus_early_hex(top_of_kernel_data);
+	cepheus_early_putc('\n');
+}
