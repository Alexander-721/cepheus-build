diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index f2999fe..22ce3a2 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1834,6 +1834,32 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	/*
 	 * Get the virtual and physical kernel-managed memory base from boot_args.
 	 */
+	{
+		static const char ceph_hx[] = "0123456789abcdef";
+		static const char *ceph_names[4] = { "virt", "phys", "size", "top " };
+		unsigned long long ceph_vals[4];
+		ceph_vals[0] = (unsigned long long)args->virtBase;
+		ceph_vals[1] = (unsigned long long)args->physBase;
+		ceph_vals[2] = (unsigned long long)args->memSize;
+		ceph_vals[3] = (unsigned long long)args->topOfKernelData;
+		for (int ceph_n = 0; ceph_n < 4; ceph_n++) {
+			const char *ceph_p = "CEPHEUS ARGS ";
+			while (*ceph_p != 0) {
+				cepheus_early_putc(*ceph_p++);
+			}
+			ceph_p = ceph_names[ceph_n];
+			while (*ceph_p != 0) {
+				cepheus_early_putc(*ceph_p++);
+			}
+			cepheus_early_putc('=');
+			cepheus_early_putc('0');
+			cepheus_early_putc('x');
+			for (int ceph_i = 15; ceph_i >= 0; ceph_i--) {
+				cepheus_early_putc(ceph_hx[(ceph_vals[ceph_n] >> (ceph_i * 4)) & 0xf]);
+			}
+			cepheus_early_putc('\n');
+		}
+	}
 	gVirtBase = args->virtBase;
 	cepheus_early_mark(20, "V1: arm_vm_init entered");
 	gPhysBase = args->physBase;
