diff --git a/osfmk/kern/processor.c b/osfmk/kern/processor.c
index 6b522d0..1eee2a9 100644
--- a/osfmk/kern/processor.c
+++ b/osfmk/kern/processor.c
@@ -253,7 +253,10 @@ processor_init(
 {
 	spl_t           s;
 
+	cepheus_early_mark(20, (cpu_id < MAX_SCHED_CPUS)
+	    ? "Q0: cpu_id in range" : "Q0: cpu_id OUT OF RANGE");
 	assert(cpu_id < MAX_SCHED_CPUS);
+	cepheus_early_mark(20, "Q1: assert passed");
 	processor->cpu_id = cpu_id;
 
 	if (processor != master_processor) {
@@ -261,6 +264,7 @@ processor_init(
