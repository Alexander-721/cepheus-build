+void
+cepheus_early_fb_report(uintptr_t pa, uint64_t bytes, uintptr_t ptov_pa, uint64_t ptov_len)
+{
+	cepheus_early_string("\nCEPH FB pa=0x");
+	cepheus_early_hex(pa);
+	cepheus_early_string(" len=0x");
+	cepheus_early_hex((uintptr_t)bytes);
+	cepheus_early_string("\nCEPH PTOV pa=0x");
+	cepheus_early_hex(ptov_pa);
+	cepheus_early_string(" len=0x");
+	cepheus_early_hex((uintptr_t)ptov_len);
+	cepheus_early_putc('\n');
+}
